{
  "name": "house-of-alden",
  "private": true,
  "description": "House of Alden — the shop (static HTML) and its admin (/admin), on Firebase and Vercel.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup:firebase": "node scripts/setup-firebase.mjs",
    "test": "firebase emulators:exec --only auth,firestore,storage --project demo-house-of-alden \"node --test --test-concurrency=1 tests/*.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "esbuild": "0.25.10",
    "firebase": "12.19.0",
    "jsdom": "30.1.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  }
}
