# House of Alden — server environment variables (names only, no values).
# Real values go in Vercel → Project → Settings → Environment Variables.
# Never put real values in this file or anywhere in the repository.

# From the Firebase service-account JSON (Project settings → Service accounts):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: extra site addresses allowed to call /api (comma-separated),
# e.g. a preview domain. The site's own address is always allowed.
ALLOWED_ORIGINS=
